# Production settings for Docker. Copy to docker/env/production.env (never commit that file; keep it readable only by the deploy user: chmod 600).
# Compose reads it twice: for the containers and for the values inside compose.yaml.

# --- Compose -----------------------------------------------------------------
# The address people type. DNS must point at this server.
SITE_ADDRESS=emms.example.com
# acme   = free public certificate from Let's Encrypt, renewed automatically (ports 80 and 443 must reach this server)
# custom = your own certificate: put fullchain.pem and privkey.pem in ./certs
TLS_MODE=acme
ACME_EMAIL=it.admin@ravago.com.ph
# Service account JSON for the Google Sheets / Gmail syncs (mounted read-only, not baked into the image).
GOOGLE_CREDENTIALS_FILE=./secrets/google-sheets-credentials.json
# Tag for the built images, e.g. a release number, so you can roll back.
IMAGE_TAG=latest

# --- Application ---------------------------------------------------------------
APP_NAME=EMMS
APP_ENV=production
# The container refuses to start with APP_DEBUG=true in production.
APP_DEBUG=false
# Generate once and never lose it (it decrypts stored data): docker compose --env-file docker/env/production.env -f compose.yaml -f compose.production.yaml run --rm --no-deps -e APP_KEY=x -e SKIP_OPTIMIZE=1 app php artisan key:generate --show
APP_KEY=
APP_URL=https://emms.example.com
APP_LOCALE=en
TZ=Asia/Manila

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Database ------------------------------------------------------------------
DB_CONNECTION=mysql
# A database on the Docker host: host.docker.internal. Another server: its name or IP.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=emms
DB_USERNAME=emms
DB_PASSWORD=

# Other databases the app reads.
# DB_AUTH_HOST=
# DB_AUTH_PORT=3306
# DB_AUTH_DATABASE=
# DB_AUTH_USERNAME=
# DB_AUTH_PASSWORD=
# DB_AIMS_HOST=
# DB_AIMS_PORT=3306
# DB_AIMS_DATABASE=
# DB_AIMS_USERNAME=
# DB_AIMS_PASSWORD=

# --- Sessions, cache, queue (all in the database; no Redis needed) ----------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# --- Mail ----------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- Google ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://emms.example.com/auth/google/callback
GOOGLE_SPREADSHEET_ID=

# --- RFID ------------------------------------------------------------------------
RFID_ALERTS_ENABLED=true
RFID_ALERT_EMAILS=it.admin@ravago.com.ph
RFID_SILENCE_MINUTES=720
RFID_NO_SCANS_MINUTES=240
RFID_ALERT_WINDOW_START=06:00
RFID_ALERT_WINDOW_END=20:00
RFID_ALERT_DAYS=1,2,3,4,5,6
RFID_REMINDER_HOURS=6
RFID_TOKEN_WARNING_DAYS=30
RFID_RAW_LOG_RETENTION_DAYS=7
RFID_PROCESS_CHUNK=1000
RFID_STUCK_AFTER_MINUTES=15
RFID_SCANNER_STALE_MINUTES=15
RFID_SCANNER_INACTIVE_ALERT_MINUTES=5
RFID_SCANNER_LOG_RETENTION_DAYS=30

RFID_MOVEMENT_EMAILS_ENABLED=true
RFID_MOVEMENT_EMAIL_MAX_AGE_MINUTES=180

# Testing environment settings for Docker. Copy to docker/env/testing.env (never commit that file).
# Compose reads it twice: for the containers and for the values inside compose.yaml.

# --- Compose -----------------------------------------------------------------
SITE_ADDRESS=localhost:8443
HTTPS_PORT=8443
TLS_MODE=internal
# Service account JSON for the Google Sheets / Gmail syncs (mounted read-only, not baked into the image).
# Testing must not use the real account: use a stub or a test service account, or the test scheduler will read and change real mail.
GOOGLE_CREDENTIALS_FILE=./secrets/google-sheets-credentials.json

# --- Application ---------------------------------------------------------------
APP_NAME=EMMS
# "staging" keeps testing separate from production while debug stays off.
APP_ENV=staging
APP_DEBUG=false
# Generate: docker compose --env-file docker/env/testing.env -f compose.yaml -f compose.testing.yaml run --rm --no-deps -e APP_KEY=x -e SKIP_OPTIMIZE=1 app php artisan key:generate --show
APP_KEY=
APP_URL=https://localhost:8443
APP_LOCALE=en
TZ=Asia/Manila

LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Database (the db container from compose.testing.yaml) ----------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=emms
DB_USERNAME=emms
DB_PASSWORD=change-me-to-a-long-random-password

# Other databases the app reads (leave out what testing does not use).
# DB_AUTH_HOST=
# DB_AUTH_PORT=3306
# DB_AUTH_DATABASE=
# DB_AUTH_USERNAME=
# DB_AUTH_PASSWORD=
# DB_AIMS_HOST=
# DB_AIMS_PORT=3306
# DB_AIMS_DATABASE=
# DB_AIMS_USERNAME=
# DB_AIMS_PASSWORD=

# --- Sessions, cache, queue (all in the database; no Redis needed) ----------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# --- Mail ----------------------------------------------------------------------
# Testing should not email real people: keep "log" (mails go to the container log) or point to a test mailbox.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=emms-test@example.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Google ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://localhost:8443/auth/google/callback
GOOGLE_SPREADSHEET_ID=

# --- RFID ------------------------------------------------------------------------
# Alerts stay off in testing so nobody is emailed.
RFID_ALERTS_ENABLED=false
RFID_ALERT_EMAILS=it.admin@ravago.com.ph
RFID_RAW_LOG_RETENTION_DAYS=7
RFID_SCANNER_STALE_MINUTES=15
RFID_SCANNER_INACTIVE_ALERT_MINUTES=5
RFID_SCANNER_LOG_RETENTION_DAYS=30

# Testing must not email real people about time outs / time ins.
RFID_MOVEMENT_EMAILS_ENABLED=false

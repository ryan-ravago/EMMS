# Caddy: terminates HTTPS, serves static files, and passes PHP requests to the app container (PHP-FPM).
#
# Settings come from the environment:
#   SITE_ADDRESS  the address people use, e.g. emms.example.com  (testing: localhost:8443)
#   TLS_MODE      acme      public certificate from Let's Encrypt, renewed automatically (needs ports 80 and 443 reachable)
#                 custom    your own certificate in /certs (fullchain.pem and privkey.pem)
#                 internal  certificate from Caddy's own local authority (testing only; browsers warn until it is trusted)
#   ACME_EMAIL    contact address for Let's Encrypt (acme mode)

{
	# No admin API: nothing to expose, nothing to attack.
	admin off
	# Never try to add Caddy's test authority to the container's trust store (the container is read-only).
	skip_install_trust
	servers {
		protocols h1 h2 h3
	}
	log {
		output stderr
		format json
		level WARN
	}
}

# Health check for Docker only. Not published, only reachable inside the container.
http://:8081 {
	bind 127.0.0.1
	root * /var/www/html/public
	php_fastcgi app:9000 {
		try_files index.php
	}
}

{$SITE_ADDRESS:localhost} {
	import /etc/caddy/tls/{$TLS_MODE:acme}.caddy

	root * /var/www/html/public
	encode zstd gzip

	# Same ceiling as PHP (post_max_size 25M).
	request_body {
		max_size 25MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
		-Server
		-X-Powered-By
	}

	# Hidden files (.env, .git, ...) never exist in this image, but are refused anyway. .well-known stays open.
	@hidden {
		path_regexp hidden /\.
		not path /.well-known/*
	}
	handle @hidden {
		respond 404
	}

	# PHP only ever runs through index.php. Any other .php path (an uploaded file, for example) is refused.
	@otherPhp {
		path *.php
		not path /index.php
	}
	handle @otherPhp {
		respond 404
	}

	# Files that exist on disk are served straight from here, without starting PHP.
	@static {
		file
		not path *.php
	}
	handle @static {
		# Vite builds carry a hash in the file name, so they can be cached for good.
		@hashed path /build/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header /css/* Cache-Control "public, max-age=604800"
		header /js/* Cache-Control "public, max-age=604800"
		header /fonts/* Cache-Control "public, max-age=2592000"
		file_server
	}

	# Everything else is the Laravel application.
	handle {
		php_fastcgi app:9000 {
			try_files index.php
			read_timeout 70s
			write_timeout 70s
		}
	}

	log {
		output stdout
		format json
		level INFO
	}
}

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google sign-in (OAuth client) and the AppSheet spreadsheet the inspection syncs read.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GOOGLE_SPREADSHEET_ID=

# Work order reply mailbox: replies to work order emails are read from this Gmail inbox and added to the work order.
# To change the mailbox, change both addresses; the account must be an active EMMS user and must sign in to EMMS
# with Google once (that stores the Gmail permission). When WORK_ORDER_GMAIL_ACCOUNT is empty nothing is synced.
WORK_ORDER_GMAIL_ACCOUNT=
WORK_ORDER_REPLY_TO_ADDRESS=
WORK_ORDER_REPLY_MARKER="--- Please reply above this line ---"
# Switch the sync off, how many days back unread replies are read, and how many are read per run (every minute).
WORK_ORDER_REPLY_SYNC_ENABLED=true
WORK_ORDER_REPLY_MAX_AGE_DAYS=7
WORK_ORDER_REPLY_BATCH_SIZE=50

# The AIMS database connection (config/database.php) the AIMS import commands read from.
# DB_AIMS_CONNECTION=sqlsrv_aims

# RFID reader alerts (rfid:check-health). Turn on in production only; see config/rfid.php.
RFID_ALERTS_ENABLED=false
RFID_ALERT_EMAILS=it.admin@ravago.com.ph
RFID_SILENCE_MINUTES=60
RFID_NO_SCANS_MINUTES=240
RFID_ALERT_WINDOW_START=06:00
RFID_ALERT_WINDOW_END=20:00
RFID_ALERT_DAYS=1,2,3,4,5,6
RFID_REMINDER_HOURS=6
RFID_TOKEN_WARNING_DAYS=30

# Raw RFID reader log: kept this many days (whole days, at least 1), processed in chunks, "stuck" alert after this many minutes waiting.
RFID_RAW_LOG_RETENTION_DAYS=7
RFID_PROCESS_CHUNK=1000
RFID_STUCK_AFTER_MINUTES=15

# Scanner status relayed by the reader server (about every 5 minutes): "No report" after this many minutes,
# alert once a scanner has been inactive this many minutes, change history kept this many days.
RFID_SCANNER_STALE_MINUTES=15
RFID_SCANNER_INACTIVE_ALERT_MINUTES=5
RFID_SCANNER_LOG_RETENTION_DAYS=30

# Email the asset admins and managers on every equipment / service vehicle time out and time in.
# Events older than the limit are never emailed (so rebuilding old trips stays quiet).
RFID_MOVEMENT_EMAILS_ENABLED=true
RFID_MOVEMENT_EMAIL_MAX_AGE_MINUTES=180
# Scans of the same equipment closer together than this many seconds are one trip.
RFID_MOVEMENT_WINDOW_SECONDS=300

# Who is online (super admins see it on the Users page): online while the last request is newer than this, and
# at most one database write per user per this many seconds.
PRESENCE_ONLINE_SECONDS=120
PRESENCE_WRITE_EVERY_SECONDS=30
